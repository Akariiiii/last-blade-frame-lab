#include "version.h"
1 24 "app.manifest"
1 VERSIONINFO
FILEVERSION FRAME_LAB_FILE_VERSION
PRODUCTVERSION FRAME_LAB_FILE_VERSION
FILEFLAGSMASK 0x3fL
FILEFLAGS FRAME_LAB_PRERELEASE
FILEOS 0x40004L
FILETYPE 0x1L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Frame Lab Contributors\0"
      VALUE "FileDescription", "Last Blade 2 Frame Lab\0"
      VALUE "FileVersion", FRAME_LAB_VERSION "\0"
      VALUE "OriginalFilename", "Last Blade 2 Frame Lab.exe\0"
      VALUE "ProductName", "Last Blade 2 Frame Lab\0"
      VALUE "ProductVersion", FRAME_LAB_VERSION "\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
